#!/bin/sh
set -eu

endpoint=
for argument in "$@"; do
    case "$argument" in
        graphql) endpoint=graphql ;;
        -*|api|github.com) ;;
        *) [ "$endpoint" = graphql ] || endpoint=$argument ;;
    esac
done

respond() {
    status=$1
    body=$2
    printf 'HTTP/2 %s\nX-Poll-Interval: 1\n\n%s' "$status" "$body"
}

notification='[{"id":"demo-notification","reason":"review_requested","unread":true,"updated_at":"2030-01-01T00:00:00Z","repository":{"id":7,"full_name":"acme/widgets"},"subject":{"title":"Add retry support","type":"PullRequest","url":"https://api.github.com/repos/acme/widgets/pulls/42"}}]'

case "$endpoint" in
    /user)
        respond '200 OK' '{"id":1,"login":"demo-user"}'
        ;;
    '/user/teams?per_page=100')
        respond '200 OK' '[]'
        ;;
    /repos/acme/widgets)
        respond '200 OK' '{"id":7,"full_name":"acme/widgets","html_url":"https://github.com/acme/widgets"}'
        ;;
    '/repos/acme/widgets/notifications?all=true&per_page=100')
        respond '200 OK' "$notification"
        ;;
    '/notifications?all=true&per_page=50')
        respond '304 Not Modified' ''
        exit 1
        ;;
    graphql)
        cat >/dev/null
        empty='{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[]}'
        body=$(printf '{"data":{"r0":{"p0":{"databaseId":99,"number":42,"url":"https://github.com/acme/widgets/pull/42","title":"Add retry support","state":"OPEN","isDraft":false,"merged":false,"headRefOid":"%s","headRefName":"retry-support","baseRefOid":"%s","baseRefName":"main","author":{"__typename":"User","login":"octo-author","databaseId":2},"reviewRequests":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[{"requestedReviewer":{"__typename":"User","databaseId":1,"login":"demo-user"}}]},"reviews":%s,"timelineItems":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[{"id":"RRE_demo","createdAt":"2030-01-01T00:00:00Z","requestedReviewer":{"__typename":"User","databaseId":1,"login":"demo-user"}}]}}}}}' "$DEMO_HEAD_SHA" "$DEMO_BASE_SHA" "$empty")
        respond '200 OK' "$body"
        ;;
    *)
        printf 'demo gh: unexpected endpoint %s\n' "$endpoint" >&2
        exit 2
        ;;
esac
